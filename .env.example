DISCORD_TOKEN=
# Compose는 기본으로 함께 실행하는 PostgreSQL을 사용합니다.
# 기존 SQLite 배포의 데이터를 계속 사용하려면 아래 줄의 주석을 해제합니다.
# 로컬 `uv run`은 주석 상태에서도 이 SQLite 경로를 기본값으로 사용합니다.
# DATABASE_URL=sqlite+aiosqlite:///./data/movie-bot.sqlite3
POSTGRES_DB=cgv_push_bot
POSTGRES_USER=cgv_push_bot
POSTGRES_PASSWORD=cgv_push_bot_dev
POLL_INTERVAL_SECONDS=300
POLL_OFFSET_SECONDS=1
LOG_LEVEL=INFO
HISTORY_RETENTION_DAYS=90
DASHBOARD_PASSWORD=
DASHBOARD_PORT=8080
DASHBOARD_COOKIE_SECURE=false
